e:Tbc8,[{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Cos'è Artpay?","acceptedAnswer":{"@type":"Answer","text":"Artpay porta il pagamento rateale nel flusso dell'asta e riunisce partner finanziari regolamentati come Santander e Klarna in un'unica interfaccia, mentre credito e fondi restano in capo ai partner."}},{"@type":"Question","name":"Come funziona Artpay FAST?","acceptedAnswer":{"@type":"Answer","text":"Generi il link in circa 20 secondi e lo invii al collezionista per WhatsApp, email o QR. Lui sceglie il piano e il partner finanziario versa il 100% alla casa d'asta."}},{"@type":"Question","name":"Fino a quanti mesi si può rateizzare?","acceptedAnswer":{"@type":"Answer","text":"Da 3 a 84 mesi, in base al partner finanziario e al profilo del collezionista. I piani più frequenti vanno da 3 a 48 mesi."}},{"@type":"Question","name":"Quanto costa Artpay?","acceptedAnswer":{"@type":"Answer","text":"La commissione di servizio è a carico dell'acquirente e la percentuale si definisce con ogni casa d'asta. Viene mostrata prima della scelta del metodo di pagamento e la proposta sulla tua asta si vede in demo."}},{"@type":"Question","name":"Le commissioni d'asta entrano nel piano rateale?","acceptedAnswer":{"@type":"Answer","text":"Sì, lotto e commissioni confluiscono in un'unica rata mensile."}},{"@type":"Question","name":"E se il finanziamento viene rifiutato?","acceptedAnswer":{"@type":"Answer","text":"Decide il partner finanziario, quindi la casa d'asta tiene disponibile un metodo di pagamento alternativo."}},{"@type":"Question","name":"Si integra con il mio gestionale?","acceptedAnswer":{"@type":"Answer","text":"Artpay si aggiunge al processo esistente senza modifiche strutturali, e le integrazioni native con i software d'asta sono in sviluppo."}},{"@type":"Question","name":"Il collezionista deve scaricare un'app?","acceptedAnswer":{"@type":"Answer","text":"Il link si apre dal browser del telefono, quindi il collezionista non scarica nulla."}},{"@type":"Question","name":"La casa d'asta mantiene il rapporto con il collezionista?","acceptedAnswer":{"@type":"Answer","text":"Il rapporto resta diretto, perché il checkout porta il marchio della casa d'asta e Artpay rimane un supporto discreto."}},{"@type":"Question","name":"Artpay è conforme alla normativa italiana?","acceptedAnswer":{"@type":"Answer","text":"Artpay è progettato per la conformità, fornisce la tecnologia mentre credito e fondi restano ai partner finanziari e il processo è interamente digitale. È pronto al D.Lgs. 212/2025 (CCD2)."}},{"@type":"Question","name":"Artpay è disponibile solo in Italia?","acceptedAnswer":{"@type":"Answer","text":"Oggi il servizio è attivo in Italia, mentre Spagna e Francia sono in roadmap."}}]},{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Home","item":"https://artpay.art/"},{"@type":"ListItem","position":2,"name":"FAQ","item":"https://artpay.art/faq"}]}]b:["$","$1","c",{"children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$e"}}],["$","$Lf",null,{}]],null,["$","$L10",null,{"children":["$L11",["$","$L12",null,{"promise":"$@13"}]]}]]}]
