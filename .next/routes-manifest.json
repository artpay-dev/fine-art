{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/accedi",
      "regex": "^/accedi(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/accedi(?:/)?$"
    },
    {
      "page": "/chi-siamo",
      "regex": "^/chi\\-siamo(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/chi\\-siamo(?:/)?$"
    },
    {
      "page": "/come-funziona",
      "regex": "^/come\\-funziona(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/come\\-funziona(?:/)?$"
    },
    {
      "page": "/contatti",
      "regex": "^/contatti(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/contatti(?:/)?$"
    },
    {
      "page": "/demo",
      "regex": "^/demo(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/demo(?:/)?$"
    },
    {
      "page": "/faq",
      "regex": "^/faq(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/faq(?:/)?$"
    },
    {
      "page": "/partner",
      "regex": "^/partner(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/partner(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    },
    {
      "page": "/soluzioni/artisti",
      "regex": "^/soluzioni/artisti(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/soluzioni/artisti(?:/)?$"
    },
    {
      "page": "/soluzioni/case-daste",
      "regex": "^/soluzioni/case\\-daste(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/soluzioni/case\\-daste(?:/)?$"
    },
    {
      "page": "/soluzioni/fiere",
      "regex": "^/soluzioni/fiere(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/soluzioni/fiere(?:/)?$"
    },
    {
      "page": "/soluzioni/gallerie",
      "regex": "^/soluzioni/gallerie(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/soluzioni/gallerie(?:/)?$"
    },
    {
      "page": "/soluzioni/piattaforme",
      "regex": "^/soluzioni/piattaforme(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/soluzioni/piattaforme(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
